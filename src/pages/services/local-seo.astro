---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../data/site';

const pageTitle = 'Local SEO for Wisconsin Contractors & Small Businesses | North Star Digital';
const description =
  'Get your business to the top of Google and Google Maps for local searches in Waukesha, Milwaukee, and Wisconsin. North Star Digital handles local SEO for contractors and service businesses \u2014 included in our monthly plans.';

const phone = siteConfig.phone;
const phoneHref = siteConfig.phoneHref;

const includes = [
  'Google Business Profile setup and ongoing optimization',
  'Local keyword research (your service + your city)',
  'On-page SEO for all website pages',
  'Citation building — consistent listings across Google, Bing, Apple Maps, Yelp, and more',
  'Review generation strategy — simple system to get more 5-star reviews',
  'Monthly Google Maps ranking report',
  "Competitor gap analysis — see what your top competitors are doing that you're not",
];
---

<BaseLayout title={pageTitle} description={description} path="/services/local-seo">

  <!-- HERO -->
  <section class="bg-[#0B2545] px-4 py-16 md:py-20">
    <div class="mx-auto max-w-4xl">
      <a href="/services" class="mb-6 inline-flex items-center gap-1 text-sm text-[#8EA8C3] transition hover:text-white">← All Services</a>
      <p class="mt-4 text-xs font-semibold uppercase tracking-widest text-[#2E8BFF]">Local SEO</p>
      <h1 class="mt-3 text-4xl font-bold text-white md:text-5xl">Show Up When Customers Search for You</h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-[#8EA8C3]">
        When someone in Waukesha or Milwaukee searches for your service, you want to be at the top of the results — not your competitor. We do the ongoing work to get you there and keep you there.
      </p>
      <div class="mt-8 flex flex-col gap-4 sm:flex-row">
        <a href={phoneHref} class="inline-flex items-center gap-2 rounded-xl bg-[#2E8BFF] px-8 py-4 text-base font-bold text-white transition hover:bg-[#1E7AEB]">
          📞 Call Now — {phone}
        </a>
        <a href="/contact" class="inline-flex rounded-xl border-2 border-white/30 px-8 py-4 text-base font-semibold text-white transition hover:border-white hover:bg-white/10">
          Get a Free Quote
        </a>
      </div>
    </div>
  </section>

  <!-- WHAT IS LOCAL SEO -->
  <section class="px-4 py-20 md:py-24">
    <div class="mx-auto max-w-5xl">
      <div class="grid gap-12 md:grid-cols-2 md:items-center">
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-[#2E8BFF]">What Local SEO Actually Is</p>
          <h2 class="mt-3 text-3xl font-bold text-[#0B2545] md:text-4xl">The Three Spots That Get 80% of Calls</h2>
          <p class="mt-4 text-base leading-relaxed text-[#44506A]">
            When someone searches "plumber Waukesha" or "masonry contractor near me," Google shows a map with three businesses at the top — the Local Pack. Those three businesses get the vast majority of clicks and calls.
          </p>
          <p class="mt-4 text-base leading-relaxed text-[#44506A]">
            Getting into that map pack requires consistent work on your Google Business Profile, your website, and your reputation (reviews). It's not a one-time fix — it's an ongoing process that compounds over time.
          </p>
          <p class="mt-4 text-base leading-relaxed text-[#44506A]">
            We handle all of it so you can focus on doing the work, not figuring out how to rank.
          </p>
        </div>
        <div class="space-y-4">
          {[
            ['📍', 'Google Maps Pack', 'The top 3 local results. Gets the most clicks for "near me" searches.'],
            ['🔍', 'Organic Search', 'Your website ranking below the map pack. Builds trust and drives research-mode traffic.'],
            ['⭐', 'Review Signals', 'More reviews, higher ratings, and regular responses tell Google you\'re active and trusted.'],
          ].map(([icon, title, desc]) => (
            <div class="rounded-2xl border border-[#E3E8F1] bg-[#F4F6FA] p-5">
              <p class="font-bold text-[#0B2545]"><span class="mr-2">{icon}</span>{title}</p>
              <p class="mt-1 text-sm text-[#44506A]">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- INCLUDES + PRICING -->
  <section class="bg-[#F4F6FA] px-4 py-20 md:py-24">
    <div class="mx-auto max-w-5xl">
      <div class="grid gap-12 md:grid-cols-2 md:items-start">
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-[#2E8BFF]">What's Included</p>
          <h2 class="mt-3 text-3xl font-bold text-[#0B2545]">Monthly Local SEO — Everything Done for You</h2>
          <ul class="mt-6 space-y-3">
            {includes.map(item => (
              <li class="flex items-start gap-3 text-sm text-[#44506A]">
                <span class="mt-0.5 font-bold text-[#2E8BFF]">✓</span>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-[#2E8BFF]">Pricing</p>
          <h2 class="mt-3 text-3xl font-bold text-[#0B2545]">Simple Monthly Rate</h2>
          <div class="mt-6 rounded-2xl border-2 border-[#2E8BFF]/20 bg-white p-6 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-widest text-[#2E8BFF]">Included In Your Plan</p>
            <p class="mt-2 text-2xl font-bold text-[#0B2545]">Fully-managed local SEO, every month</p>
            <p class="mt-2 text-sm text-[#44506A]">Local SEO is built into our Core and Premium plans \u2014 not a separate line item. Plans start at $247/mo.</p>
            <a href="/services" class="mt-5 inline-flex items-center gap-2 rounded-xl bg-[#2E8BFF] px-6 py-3 text-sm font-bold text-white transition hover:bg-[#1E7AEB]">
              See Plans & Pricing \u2192
            </a>
          </div>
          <div class="mt-4 rounded-2xl border border-[#E3E8F1] bg-white p-5 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-widest text-[#2E8BFF]">What You Also Get</p>
            <p class="mt-2 text-sm text-[#44506A]">Our <a href="/services" class="font-semibold text-[#2E8BFF] hover:underline">Core and Premium plans</a> add CRM, automated follow-up, and a monthly strategy call on top of local SEO. See the Services page for full pricing.</p>
          </div>
          <p class="mt-4 text-xs text-[#44506A]">No contracts. Month-to-month. Cancel anytime with 30 days notice.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- TIMELINE / WHAT TO EXPECT -->
  <section class="px-4 py-20 md:py-24">
    <div class="mx-auto max-w-4xl">
      <div class="mb-12 text-center">
        <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-[#2E8BFF]">Honest Expectations</p>
        <h2 class="text-3xl font-bold text-[#0B2545] md:text-4xl">How Long Does SEO Take?</h2>
        <p class="mx-auto mt-4 max-w-xl text-base text-[#44506A]">We'll be straight with you — SEO isn't instant. Here's what you can realistically expect.</p>
      </div>
      <div class="space-y-4">
        {[
          ['Weeks 1–2', 'GBP claimed, optimized, and verified. Initial keyword research and on-page fixes applied.'],
          ['Month 1', 'Measurable improvements to GBP visibility. Local citations built. Review generation started.'],
          ['Months 2–3', 'Rankings improving for primary keywords. Map pack appearances increasing for your target area.'],
          ['Month 3+', 'Compounding growth. Each month of consistent work builds on the last. This is where the calls start coming in steadily.'],
        ].map(([period, desc]) => (
          <div class="flex gap-5 rounded-2xl border border-[#E3E8F1] bg-white p-5 shadow-sm">
            <div class="w-28 shrink-0 text-sm font-bold text-[#2E8BFF]">{period}</div>
            <p class="text-sm leading-relaxed text-[#44506A]">{desc}</p>
          </div>
        ))}
      </div>
      <div class="mt-8 rounded-2xl border border-[#2E8BFF]/20 bg-[#F0F6FF] p-6 text-center">
        <p class="text-sm font-bold text-[#0B2545]">Our 30-Day Results Guarantee</p>
        <p class="mt-2 text-sm text-[#44506A]">If you don't see measurable progress in your first 30 days — more traffic, better GBP rankings, or more inquiries — we keep working at no extra charge until you do.</p>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="bg-[#0B2545] px-4 py-20 md:py-24">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="text-3xl font-bold text-white md:text-4xl">Ready to Start Ranking Locally?</h2>
      <p class="mx-auto mt-5 max-w-xl text-lg text-[#8EA8C3]">We'll audit your current Google presence for free and show you exactly where you stand and what it would take to rank above your competitors.</p>
      <div class="mt-8 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        <a href={phoneHref} class="inline-flex items-center gap-2 rounded-xl bg-[#2E8BFF] px-8 py-4 text-base font-bold text-white transition hover:bg-[#1E7AEB]">
          📞 Call Now — {phone}
        </a>
        <a href="/contact" class="inline-flex rounded-xl border-2 border-white/30 px-8 py-4 text-base font-semibold text-white transition hover:border-white hover:bg-white/10">
          Get a Free Quote
        </a>
      </div>
      <p class="mt-5 text-sm text-[#8EA8C3]">Also see: <a href="/services/web-design" class="text-[#06D6FF] hover:underline">Website Design</a> · <a href="/services" class="text-[#06D6FF] hover:underline">All Services</a> · <a href="/faq" class="text-[#06D6FF] hover:underline">FAQ</a></p>
    </div>
  </section>

</BaseLayout>
