---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../data/site';

const pageTitle = 'Website Design for Contractors & Small Businesses | North Star Digital — Pewaukee, WI';
const description =
  'North Star Digital builds fast, mobile-ready websites for Wisconsin contractors, plumbers, HVAC, and service businesses. Built to get your phone ringing \u2014 not just look good.';

const phone = siteConfig.phone;
const phoneHref = siteConfig.phoneHref;

const includes = [
  'Custom design built around your trade and service area',
  'Mobile-first — looks perfect on every phone',
  'Phone number visible above the fold on every page',
  'Photo gallery for your work (before/afters, project shots)',
  'Fast contact form connected to your email',
  'Basic on-page SEO setup (title tags, meta descriptions, headings)',
  'Google Maps embed and service area page',
  'You own the site — no platform lock-in, ever',
  'Delivered in 2–3 weeks',
];

const notIncludes = [
  'Paid ad spend \u2014 we focus on organic growth, not Google Ads',
  'Online stores / e-commerce \u2014 we build lead-generation sites for service businesses',
];
---

<BaseLayout title={pageTitle} description={description} path="/services/web-design">

  <!-- HERO -->
  <section class="bg-[#0B2545] px-4 py-16 md:py-20">
    <div class="mx-auto max-w-4xl">
      <a href="/services" class="mb-6 inline-flex items-center gap-1 text-sm text-[#8EA8C3] transition hover:text-white">← All Services</a>
      <p class="mt-4 text-xs font-semibold uppercase tracking-widest text-[#2E8BFF]">Website Design & Development</p>
      <h1 class="mt-3 text-4xl font-bold text-white md:text-5xl">A Website That Actually Gets You Calls</h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-[#8EA8C3]">
        Most contractor websites look okay but don't convert. We build fast, mobile-ready sites designed around one goal: getting your phone to ring. You own it, no lock-in, delivered in 2–3 weeks.
      </p>
      <div class="mt-8 flex flex-col gap-4 sm:flex-row">
        <a href={phoneHref} class="inline-flex items-center gap-2 rounded-xl bg-[#2E8BFF] px-8 py-4 text-base font-bold text-white transition hover:bg-[#1E7AEB]">
          📞 Call Now — {phone}
        </a>
        <a href="/contact" class="inline-flex rounded-xl border-2 border-white/30 px-8 py-4 text-base font-semibold text-white transition hover:border-white hover:bg-white/10">
          Get a Free Quote
        </a>
      </div>
    </div>
  </section>

  <!-- PRICE + WHAT'S INCLUDED -->
  <section class="px-4 py-20 md:py-24">
    <div class="mx-auto max-w-5xl">
      <div class="grid gap-12 md:grid-cols-2 md:items-start">

        <!-- Left -->
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-[#2E8BFF]">What You Get</p>
          <h2 class="mt-3 text-3xl font-bold text-[#0B2545] md:text-4xl">Everything in One Build</h2>
          <p class="mt-4 text-base leading-relaxed text-[#44506A]">
            We handle the whole project. Design, development, content structure, basic SEO, and launch. You give us your logo, some photos of your work, and a little time for a kickoff call — we handle everything else.
          </p>
          <p class="mt-4 text-base leading-relaxed text-[#44506A]">
            Every site we build is fast by default. We use Astro — the same framework that powers major media companies — because it ships zero JavaScript unless you need it. Your site loads in under 2 seconds on mobile.
          </p>
          <div class="mt-6 rounded-2xl border-2 border-[#2E8BFF]/20 bg-[#F0F6FF] p-6">
            <p class="text-xs font-semibold uppercase tracking-widest text-[#2E8BFF]">Included In Every Plan</p>
            <p class="mt-2 text-2xl font-bold text-[#0B2545]">Your website is built into your monthly plan</p>
            <p class="mt-2 text-sm text-[#44506A]">We design, build, host, and maintain your site as part of one predictable monthly price \u2014 plans start at $147/mo. No big upfront bill.</p>
            <a href="/services" class="mt-5 inline-flex items-center gap-2 rounded-xl bg-[#2E8BFF] px-6 py-3 text-sm font-bold text-white transition hover:bg-[#1E7AEB]">
              See Plans & Pricing \u2192
            </a>
          </div>
        </div>

        <!-- Right: Included list -->
        <div class="space-y-3">
          <p class="text-sm font-bold text-[#0B2545]">What's included:</p>
          <ul class="space-y-2">
            {includes.map(item => (
              <li class="flex items-start gap-3 rounded-xl border border-[#E3E8F1] bg-white px-4 py-3 text-sm text-[#44506A]">
                <span class="mt-0.5 font-bold text-[#2E8BFF]">✓</span>
                {item}
              </li>
            ))}
          </ul>
          <p class="mt-4 text-xs font-semibold text-[#44506A] uppercase tracking-wide">Not included:</p>
          <ul class="space-y-2">
            {notIncludes.map(item => (
              <li class="flex items-start gap-3 text-sm text-[#44506A]">
                <span class="mt-0.5 text-[#8EA8C3]">—</span>
                {item}
              </li>
            ))}
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- WHY IT MATTERS -->
  <section class="bg-[#F4F6FA] px-4 py-20 md:py-24">
    <div class="mx-auto max-w-5xl">
      <div class="mb-12 text-center">
        <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-[#2E8BFF]">Why This Matters</p>
        <h2 class="text-3xl font-bold text-[#0B2545] md:text-4xl">A Website Is Your 24/7 Salesperson</h2>
        <p class="mx-auto mt-4 max-w-xl text-base text-[#44506A]">Most customers decide whether to call you before they ever pick up the phone — based entirely on what they find online.</p>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-2xl bg-white p-7 shadow-sm">
          <p class="text-3xl font-bold text-[#2E8BFF]">70%</p>
          <h3 class="mt-2 font-bold text-[#0B2545]">of Local Searches Are on Mobile</h3>
          <p class="mt-2 text-sm leading-relaxed text-[#44506A]">If your site isn't fast and clean on a phone screen, you lose those visitors instantly. Google also ranks mobile-friendly sites higher.</p>
        </div>
        <div class="rounded-2xl bg-white p-7 shadow-sm">
          <p class="text-3xl font-bold text-[#2E8BFF]">3 sec</p>
          <h3 class="mt-2 font-bold text-[#0B2545]">Average Time Before Someone Leaves</h3>
          <p class="mt-2 text-sm leading-relaxed text-[#44506A]">Slow sites lose customers before they see anything. Our sites load in under 2 seconds — faster than most of your competitors.</p>
        </div>
        <div class="rounded-2xl bg-white p-7 shadow-sm">
          <p class="text-3xl font-bold text-[#2E8BFF]">1st</p>
          <h3 class="mt-2 font-bold text-[#0B2545]">Impression Happens Online</h3>
          <p class="mt-2 text-sm leading-relaxed text-[#44506A]">Customers form an opinion about your business in under 10 seconds. A professional, clear website builds trust before they've spoken to you.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- TIMELINE -->
  <section class="px-4 py-20 md:py-24">
    <div class="mx-auto max-w-5xl">
      <div class="mb-12 text-center">
        <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-[#2E8BFF]">How Fast We Move</p>
        <h2 class="text-3xl font-bold text-[#0B2545] md:text-4xl">Live in 2–3 Weeks</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        {[
          ['Week 1', 'Kickoff call, content gathering, design mockup for your approval'],
          ['Week 2', 'Full build, your review, revisions, and final content'],
          ['Week 3', 'Launch — your site goes live and starts working for you'],
        ].map(([week, desc]) => (
          <div class="rounded-2xl border border-[#E3E8F1] bg-white p-7 shadow-sm text-center">
            <p class="text-xs font-semibold uppercase tracking-widest text-[#2E8BFF]">{week}</p>
            <p class="mt-3 text-sm leading-relaxed text-[#44506A]">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHO IT'S FOR -->
  <section class="bg-[#F4F6FA] px-4 py-16 md:py-20">
    <div class="mx-auto max-w-4xl text-center">
      <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-[#2E8BFF]">Who This Is For</p>
      <h2 class="text-3xl font-bold text-[#0B2545]">Built for Local Service Businesses</h2>
      <p class="mx-auto mt-4 max-w-xl text-base text-[#44506A]">We specialize in Wisconsin contractors and service businesses — not e-commerce, not SaaS, not Fortune 500. Our templates and process are built around how customers choose a local contractor.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3 text-sm font-semibold text-[#44506A]">
        {['Masonry & Concrete', 'HVAC', 'Plumbing', 'Roofing', 'Electrical', 'Landscaping', 'Painting', 'Home Services'].map(t => (
          <span class="rounded-full border border-[#E3E8F1] bg-white px-4 py-2">{t}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="bg-[#0B2545] px-4 py-20 md:py-24">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="text-3xl font-bold text-white md:text-4xl">Ready to Get a Website That Works?</h2>
      <p class="mx-auto mt-5 max-w-xl text-lg text-[#8EA8C3]">Call us for a free consultation. We'll look at your current online presence and tell you exactly what we'd build and what it would cost.</p>
      <div class="mt-8 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        <a href={phoneHref} class="inline-flex items-center gap-2 rounded-xl bg-[#2E8BFF] px-8 py-4 text-base font-bold text-white transition hover:bg-[#1E7AEB]">
          📞 Call Now — {phone}
        </a>
        <a href="/contact" class="inline-flex rounded-xl border-2 border-white/30 px-8 py-4 text-base font-semibold text-white transition hover:border-white hover:bg-white/10">
          Get a Free Quote
        </a>
      </div>
      <p class="mt-5 text-sm text-[#8EA8C3]">Also see: <a href="/services/local-seo" class="text-[#06D6FF] hover:underline">Local SEO</a> · <a href="/services" class="text-[#06D6FF] hover:underline">All Services</a> · <a href="/faq" class="text-[#06D6FF] hover:underline">FAQ</a></p>
    </div>
  </section>

</BaseLayout>
