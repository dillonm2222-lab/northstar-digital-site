---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'Contact | North Star Digital — Wisconsin';
const description =
  'Apply for a free strategy session with North Star Digital. We help small businesses grow online with AI-powered systems. Call (262) 254-0128 or fill out the form.';

const phone = '(262) 254-0128';
const phoneHref = 'tel:+12622540128';
---

<BaseLayout title={pageTitle} description={description} path="/contact">

  <!-- HERO -->
  <section class="hero-glow relative overflow-hidden px-4 py-16 md:py-20">
    <div class="pointer-events-none absolute right-1/4 top-1/4 h-64 w-64 rounded-full bg-[#06D6FF] opacity-10 blur-3xl"></div>
    <div class="relative mx-auto max-w-4xl text-center">
      <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-[#06D6FF]">Let's Talk</p>
      <h1 class="text-4xl font-bold text-white md:text-5xl">Apply for a Free Strategy Session</h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-[#8EA8C3]">
        No pressure. No sales pitch. We'll review your current online presence and tell you honestly what it would take to get more calls coming in.
      </p>
      <div class="mt-8">
        <a href={phoneHref} class="btn-glow inline-flex items-center gap-2 rounded-xl bg-[#2E8BFF] px-8 py-4 text-base font-bold text-white transition hover:bg-[#1E7AEB]">
          Call Now — {phone}
        </a>
      </div>
    </div>
  </section>

  <!-- BOOK A TIME — Calendly Embedded -->
  <section class="bg-[#F0F6FF] px-4 py-14">
    <div class="mx-auto max-w-3xl text-center">
      <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-[#2E8BFF]">Skip the Phone Tag</p>
      <h2 class="text-3xl font-bold text-[#0B2545]">Book a Time That Works for You</h2>
      <p class="mx-auto mt-4 max-w-xl text-base text-[#44506A]">Pick a time on our calendar below. We'll have everything ready before we talk.</p>
      <!-- Calendly inline widget -->
      <div
        class="calendly-inline-widget mt-8 overflow-hidden rounded-2xl border border-[#E3E8F1] shadow-sm"
        data-url="https://calendly.com/northstardigital-marketing/30min"
        style="min-width:320px;height:700px;"
      ></div>
      <script is:inline src="https://assets.calendly.com/assets/external/widget.js" async></script>
    </div>
  </section>

  <!-- CONTACT SECTION -->
  <section class="px-4 py-20 md:py-24">
    <div class="mx-auto max-w-5xl">
      <div class="grid gap-12 md:grid-cols-2 md:items-start">

        <!-- LEFT: What to expect -->
        <div>
          <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-[#2E8BFF]">What to Expect</p>
          <h2 class="text-3xl font-bold text-[#0B2545]">Here's How It Works</h2>
          <p class="mt-4 text-base leading-relaxed text-[#44506A]">
            Fill out the form and we'll get back to you within one business day. Or just call — we pick up.
          </p>
          <div class="mt-8 space-y-6">
            <div class="flex gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#2E8BFF] text-sm font-bold text-white">1</div>
              <div>
                <h3 class="font-bold text-[#0B2545]">We Review Your Online Presence</h3>
                <p class="mt-1 text-sm leading-relaxed text-[#44506A]">Before the call, we look at your current website, Google ranking, and local presence so we're not wasting your time.</p>
              </div>
            </div>
            <div class="flex gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#2E8BFF] text-sm font-bold text-white">2</div>
              <div>
                <h3 class="font-bold text-[#0B2545]">We Tell You What's Missing</h3>
                <p class="mt-1 text-sm leading-relaxed text-[#44506A]">We give you an honest breakdown — what's costing you leads, what's working, and what we'd fix first.</p>
              </div>
            </div>
            <div class="flex gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#2E8BFF] text-sm font-bold text-white">3</div>
              <div>
                <h3 class="font-bold text-[#0B2545]">You Decide If It's a Fit</h3>
                <p class="mt-1 text-sm leading-relaxed text-[#44506A]">No contracts forced on you. If we're the right team, great. If not, you leave with useful information either way.</p>
              </div>
            </div>
          </div>

          <!-- Direct contact info -->
          <div class="mt-10 rounded-2xl border border-[#E3E8F1] bg-[#F4F6FA] p-6">
            <p class="text-sm font-bold text-[#0B2545]">Prefer to reach out directly?</p>
            <a href={phoneHref} class="mt-2 block text-2xl font-bold text-[#2E8BFF] hover:underline">{phone}</a>
            <p class="mt-1 text-sm text-[#44506A]">We respond fast — usually same day.</p>
            <a href="mailto:marketing@northstardigital.services" class="mt-3 block text-sm font-semibold text-[#2E8BFF] hover:underline">marketing@northstardigital.services</a>
            <p class="mt-3 text-xs text-[#44506A]">Headquartered in Wisconsin</p>
          </div>
        </div>

        <!-- RIGHT: Form -->
        <div class="rounded-2xl border border-[#E3E8F1] bg-white p-8 shadow-sm">
          <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-[#2E8BFF]">No Phone Call Needed</p>
          <p class="mb-6 text-2xl font-bold text-[#0B2545]">Send Us a Message — We'll Handle the Rest</p>
          <form id="contact-form" action="https://formspree.io/f/xzdowbrw" method="POST" class="space-y-5">
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label for="name" class="mb-1 block text-sm font-medium text-[#0B2545]">Your Name <span class="text-red-500">*</span></label>
                <input id="name" name="Name" type="text" required placeholder="Mike Johnson" class="w-full rounded-lg border border-[#D7DFEC] px-3 py-2.5 text-sm text-[#1A1F2E] placeholder:text-[#AAB4C4] focus:border-[#2E8BFF] focus:outline-none" />
              </div>
              <div>
                <label for="business-name" class="mb-1 block text-sm font-medium text-[#0B2545]">Business Name <span class="text-red-500">*</span></label>
                <input id="business-name" name="Business Name" type="text" required placeholder="Johnson Plumbing" class="w-full rounded-lg border border-[#D7DFEC] px-3 py-2.5 text-sm text-[#1A1F2E] placeholder:text-[#AAB4C4] focus:border-[#2E8BFF] focus:outline-none" />
              </div>
            </div>
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label for="phone" class="mb-1 block text-sm font-medium text-[#0B2545]">Phone Number</label>
                <input id="phone" name="Phone" type="tel" placeholder="(262) 000-0000" class="w-full rounded-lg border border-[#D7DFEC] px-3 py-2.5 text-sm text-[#1A1F2E] placeholder:text-[#AAB4C4] focus:border-[#2E8BFF] focus:outline-none" />
              </div>
              <div>
                <label for="email" class="mb-1 block text-sm font-medium text-[#0B2545]">Email <span class="text-red-500">*</span></label>
                <input id="email" name="Email" type="email" required placeholder="mike@johnsonplumbing.com" class="w-full rounded-lg border border-[#D7DFEC] px-3 py-2.5 text-sm text-[#1A1F2E] placeholder:text-[#AAB4C4] focus:border-[#2E8BFF] focus:outline-none" />
              </div>
            </div>
            <div>
              <label for="help-with-trigger" class="mb-1 block text-sm font-medium text-[#0B2545]">What do you need help with? <span class="text-red-500">*</span></label>
              <div id="help-with" class="relative" data-multiselect>
                <button
                  type="button"
                  id="help-with-trigger"
                  aria-haspopup="listbox"
                  aria-expanded="false"
                  class="flex w-full items-center justify-between gap-2 rounded-lg border border-[#D7DFEC] px-3 py-2.5 text-left text-sm text-[#AAB4C4] focus:border-[#2E8BFF] focus:outline-none"
                >
                  <span data-ms-label>Select one or more...</span>
                  <svg data-ms-chevron class="h-4 w-4 shrink-0 text-[#44506A] transition-transform" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 8l5 5 5-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <ul
                  data-ms-panel
                  role="listbox"
                  aria-multiselectable="true"
                  class="absolute z-20 mt-1 hidden max-h-64 w-full overflow-auto rounded-lg border border-[#D7DFEC] bg-white py-1 shadow-lg"
                >
                  <li role="option" data-value="New Website" class="flex cursor-pointer items-center gap-2.5 px-3 py-2 text-sm text-[#1A1F2E] hover:bg-[#F0F6FF]"><span data-ms-check class="flex h-4 w-4 shrink-0 items-center justify-center rounded border border-[#AAB4C4] text-white"></span>New Website</li>
                  <li role="option" data-value="Website Redesign" class="flex cursor-pointer items-center gap-2.5 px-3 py-2 text-sm text-[#1A1F2E] hover:bg-[#F0F6FF]"><span data-ms-check class="flex h-4 w-4 shrink-0 items-center justify-center rounded border border-[#AAB4C4] text-white"></span>Website Redesign</li>
                  <li role="option" data-value="Local SEO" class="flex cursor-pointer items-center gap-2.5 px-3 py-2 text-sm text-[#1A1F2E] hover:bg-[#F0F6FF]"><span data-ms-check class="flex h-4 w-4 shrink-0 items-center justify-center rounded border border-[#AAB4C4] text-white"></span>Local SEO / Google Rankings</li>
                  <li role="option" data-value="CRM" class="flex cursor-pointer items-center gap-2.5 px-3 py-2 text-sm text-[#1A1F2E] hover:bg-[#F0F6FF]"><span data-ms-check class="flex h-4 w-4 shrink-0 items-center justify-center rounded border border-[#AAB4C4] text-white"></span>CRM &amp; Lead Management</li>
                  <li role="option" data-value="Automation" class="flex cursor-pointer items-center gap-2.5 px-3 py-2 text-sm text-[#1A1F2E] hover:bg-[#F0F6FF]"><span data-ms-check class="flex h-4 w-4 shrink-0 items-center justify-center rounded border border-[#AAB4C4] text-white"></span>Marketing Automation</li>
                  <li role="option" data-value="AI Voice Agent" class="flex cursor-pointer items-center gap-2.5 px-3 py-2 text-sm text-[#1A1F2E] hover:bg-[#F0F6FF]"><span data-ms-check class="flex h-4 w-4 shrink-0 items-center justify-center rounded border border-[#AAB4C4] text-white"></span>AI Voice Agent</li>
                  <li role="option" data-value="Full Package" class="flex cursor-pointer items-center gap-2.5 px-3 py-2 text-sm text-[#1A1F2E] hover:bg-[#F0F6FF]"><span data-ms-check class="flex h-4 w-4 shrink-0 items-center justify-center rounded border border-[#AAB4C4] text-white"></span>Full Package (Website + SEO + CRM + AI)</li>
                  <li role="option" data-value="Not sure" class="flex cursor-pointer items-center gap-2.5 px-3 py-2 text-sm text-[#1A1F2E] hover:bg-[#F0F6FF]"><span data-ms-check class="flex h-4 w-4 shrink-0 items-center justify-center rounded border border-[#AAB4C4] text-white"></span>Not sure — just want advice</li>
                </ul>
                <div data-ms-inputs></div>
              </div>
            </div>
            <div>
              <label for="message" class="mb-1 block text-sm font-medium text-[#0B2545]">Tell us about your business <span class="text-red-500">*</span></label>
              <textarea
                id="message"
                name="Message"
                rows="4"
                required
                placeholder="What does your business do, where are you located, and what's the biggest problem you're trying to solve?"
                class="w-full rounded-lg border border-[#D7DFEC] px-3 py-2.5 text-sm text-[#1A1F2E] placeholder:text-[#AAB4C4] focus:border-[#2E8BFF] focus:outline-none"
              ></textarea>
            </div>
            <button
              type="submit"
              class="w-full rounded-xl bg-gradient-to-r from-[#2E8BFF] to-[#06D6FF] px-5 py-4 text-base font-bold text-white shadow-lg transition hover:opacity-90 hover:shadow-xl"
            >
              Send My Free Strategy Session Request →
            </button>
            <p class="text-center text-xs text-[#44506A]">We respond within 1 business day. No spam, ever.</p>
          </form>
        </div>

      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <section class="bg-[#F0F6FF] px-4 py-12">
    <div class="mx-auto max-w-4xl">
      <div class="grid gap-6 text-center md:grid-cols-3">
        <div>
          <p class="text-3xl font-bold text-[#0B2545]">24 hrs</p>
          <p class="mt-1 text-sm text-[#44506A]">Response time or less</p>
        </div>
        <div>
          <p class="text-3xl font-bold text-[#0B2545]">2–3 wks</p>
          <p class="mt-1 text-sm text-[#44506A]">Average website launch time</p>
        </div>
        <div>
          <p class="text-3xl font-bold text-[#0B2545]">Local</p>
          <p class="mt-1 text-sm text-[#44506A]">Wisconsin — not a call center</p>
        </div>
      </div>
    </div>
  </section>

  <script>
    // Multi-select dropdown for "What do you need help with?".
    const form = document.getElementById('contact-form');
    const ms = document.getElementById('help-with');
    if (form && ms) {
      const trigger = ms.querySelector('#help-with-trigger');
      const panel = ms.querySelector('[data-ms-panel]');
      const label = ms.querySelector('[data-ms-label]');
      const chevron = ms.querySelector('[data-ms-chevron]');
      const inputs = ms.querySelector('[data-ms-inputs]');
      const options = Array.from(ms.querySelectorAll('[role="option"]'));
      const selected = new Set();
      const checkMark = '<svg viewBox="0 0 20 20" fill="currentColor" class="h-3 w-3"><path d="M16.7 5.3a1 1 0 010 1.4l-7 7a1 1 0 01-1.4 0l-3-3a1 1 0 011.4-1.4l2.3 2.3 6.3-6.3a1 1 0 011.4 0z"/></svg>';

      const open = () => { panel.classList.remove('hidden'); trigger.setAttribute('aria-expanded', 'true'); chevron.classList.add('rotate-180'); };
      const close = () => { panel.classList.add('hidden'); trigger.setAttribute('aria-expanded', 'false'); chevron.classList.remove('rotate-180'); };

      const sync = () => {
        const vals = [...selected];
        if (vals.length) {
          const names = options.filter((o) => selected.has(o.dataset.value)).map((o) => o.textContent.trim());
          label.textContent = names.length > 2 ? names.length + ' selected' : names.join(', ');
          label.classList.remove('text-[#AAB4C4]');
          label.classList.add('text-[#1A1F2E]');
        } else {
          label.textContent = 'Select one or more...';
          label.classList.add('text-[#AAB4C4]');
          label.classList.remove('text-[#1A1F2E]');
        }
        inputs.innerHTML = vals.map((v) => '<input type="hidden" name="What you need help with[]" value="' + v.replace(/"/g, '&quot;') + '">').join('');
        trigger.setCustomValidity(vals.length ? '' : 'Please select at least one option.');
      };

      options.forEach((o) => {
        o.addEventListener('click', () => {
          const v = o.dataset.value;
          const box = o.querySelector('[data-ms-check]');
          if (selected.has(v)) {
            selected.delete(v);
            o.classList.remove('bg-[#F0F6FF]');
            box.classList.remove('border-[#2E8BFF]', 'bg-[#2E8BFF]');
            box.classList.add('border-[#AAB4C4]');
            box.innerHTML = '';
          } else {
            selected.add(v);
            o.classList.add('bg-[#F0F6FF]');
            box.classList.add('border-[#2E8BFF]', 'bg-[#2E8BFF]');
            box.classList.remove('border-[#AAB4C4]');
            box.innerHTML = checkMark;
          }
          sync();
        });
      });

      trigger.addEventListener('click', () => {
        panel.classList.contains('hidden') ? open() : close();
      });
      document.addEventListener('click', (e) => { if (!ms.contains(e.target)) close(); });
      form.addEventListener('submit', (e) => {
        sync();
        if (!selected.size) { e.preventDefault(); open(); trigger.reportValidity(); }
      });
      sync();
    }
  </script>


<script is:inline>
  (function () {
    try {
      var params = new URLSearchParams(window.location.search);
      var needs = params.get('needs');
      var details = params.get('details');
      if (!needs && !details) return;
      var msg = document.getElementById('message');
      if (!msg) return;
      var lines = [];
      if (needs) lines.push('I need help with: ' + needs + '.');
      if (details) lines.push(details);
      var prefill = lines.join('\n');
      msg.value = msg.value ? (prefill + '\n\n' + msg.value) : prefill;
    } catch (e) {}
  })();
</script>
</BaseLayout>
