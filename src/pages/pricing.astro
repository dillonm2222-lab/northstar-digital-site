---
import BaseLayout from '../layouts/BaseLayout.astro';
import { plans } from '../data/site';

const pageTitle = 'Pricing | North Star Digital — Waukesha & Milwaukee Web Design';
const description =
  'Transparent pricing for local Wisconsin businesses. Website + lead automation starting at $247/month. No setup fees, no contracts, live in 2 weeks. North Star Digital, Pewaukee WI.';

const phone = '(262) 254-0128';
const phoneHref = 'tel:+12622540128';

const faqs = [
  {
    q: 'Are there any setup fees?',
    a: 'No. Your first monthly payment covers everything — setup, build, and the first 30 days of service. Nothing extra.'
  },
  {
    q: 'Is there a contract?',
    a: 'No contracts. Month-to-month only. Cancel anytime with 7 days notice. We keep your business by earning it every month.'
  },
  {
    q: 'How long until I\'m live?',
    a: 'Most clients are fully live within 10–14 days of signing. We move fast because your leads shouldn\'t have to wait.'
  },
  {
    q: 'Do I own my website?',
    a: 'Yes. If you ever cancel, we transfer your site files and content to you. No hostage situations.'
  },
  {
    q: 'What if I want to upgrade plans later?',
    a: 'Easy — just let us know. We prorate the difference and have the upgrade live within a day or two.'
  },
  {
    q: 'Do you work with businesses outside Wisconsin?',
    a: 'Our focus is Wisconsin-based businesses, but we occasionally work with businesses in neighboring states. Call us and we\'ll be straight with you about fit.'
  },
];

const compare = [
  { feature: 'GHL website (mobile-ready)', starter: true, core: true, seo: true },
  { feature: 'Contact form → email alerts', starter: true, core: true, seo: true },
  { feature: 'Fast hosting included', starter: true, core: true, seo: true },
  { feature: 'Basic local SEO setup', starter: true, core: true, seo: true },
  { feature: 'Google Business Profile setup', starter: true, core: true, seo: true },
  { feature: 'Analytics & conversion tracking', starter: true, core: true, seo: true },
  { feature: 'Monthly performance report', starter: true, core: true, seo: true },
  { feature: 'Missed-call text-back', starter: false, core: true, seo: true },
  { feature: 'Instant lead alerts to phone', starter: false, core: true, seo: true },
  { feature: 'Automated lead follow-up', starter: false, core: true, seo: true },
  { feature: 'Google review request system', starter: false, core: true, seo: true },
  { feature: 'CRM setup & pipeline management', starter: false, core: true, seo: true },
  { feature: 'Marketing automation workflows', starter: false, core: true, seo: true },
  { feature: 'Monthly strategy call', starter: false, core: true, seo: true },
  { feature: 'Fully managed local SEO', starter: false, core: false, seo: true },
  { feature: 'Google Business Profile management', starter: false, core: false, seo: true },
  { feature: 'Local citation building', starter: false, core: false, seo: true },
  { feature: 'Monthly ranking report', starter: false, core: false, seo: true },
];
---

<BaseLayout title={pageTitle} description={description} path="/pricing">

  <!-- HERO -->
  <section class="bg-[#0B2545] px-4 py-16 md:py-20">
    <div class="mx-auto max-w-4xl text-center">
      <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-[#2E8BFF]">Transparent Pricing</p>
      <h1 class="text-4xl font-bold text-white md:text-5xl">Simple Plans. No Surprises.</h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-[#8EA8C3]">
        One monthly price covers everything. No setup fees, no contracts, no hidden fees. Most clients are live in 2 weeks.
      </p>
    </div>
  </section>

  <!-- PRICING CARDS -->
  <section class="px-4 py-20 md:py-24">
    <div class="mx-auto max-w-5xl">
      <div class="grid gap-8 md:grid-cols-3">
        {plans.map((plan) => (
          <div class={`relative flex flex-col rounded-2xl border-2 ${plan.popular ? 'border-[#2E8BFF] shadow-xl shadow-blue-100' : 'border-[#E3E8F1]'} bg-white p-8`}>
            {plan.popular && (
              <div class="absolute -top-4 left-1/2 -translate-x-1/2">
                <span class="inline-block rounded-full bg-[#2E8BFF] px-5 py-1.5 text-xs font-bold uppercase tracking-widest text-white">Most Popular</span>
              </div>
            )}
            <div class="mb-6">
              <p class="text-sm font-bold uppercase tracking-widest text-[#2E8BFF]">{plan.name}</p>
              <div class="mt-2 flex items-end gap-1">
                <span class="text-5xl font-bold text-[#0B2545]">{plan.price}</span>
                <span class="mb-2 text-base text-[#44506A]">{plan.period}</span>
              </div>
              <p class="mt-3 text-sm leading-relaxed text-[#44506A]">{plan.summary}</p>
            </div>
            <ul class="mb-8 flex-1 space-y-3">
              {plan.features.map((f) => (
                <li class="flex items-start gap-2.5 text-sm text-[#44506A]">
                  <svg class="mt-0.5 h-4 w-4 shrink-0 text-[#2E8BFF]" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7 7a1 1 0 01-1.4 0l-3-3a1 1 0 011.4-1.4l2.3 2.3 6.3-6.3a1 1 0 011.4 0z" clip-rule="evenodd"/></svg>
                  {f}
                </li>
              ))}
            </ul>
            <a
              href={phoneHref}
              class={`block rounded-xl px-6 py-3 text-center text-sm font-bold transition ${plan.popular ? 'bg-[#2E8BFF] text-white hover:bg-[#1E7AEB]' : 'border-2 border-[#0B2545] text-[#0B2545] hover:bg-[#0B2545] hover:text-white'}`}
            >
              Get Started — {phone}
            </a>
          </div>
        ))}
      </div>
      <p class="mt-8 text-center text-sm text-[#44506A]">No setup fees · No contracts · Cancel anytime · Live in 2 weeks</p>
    </div>
  </section>

  <!-- COMPARISON TABLE -->
  <section class="bg-[#F4F6FA] px-4 py-20 md:py-24">
    <div class="mx-auto max-w-5xl">
      <div class="mb-12 text-center">
        <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-[#2E8BFF]">Full Comparison</p>
        <h2 class="text-3xl font-bold text-[#0B2545] md:text-4xl">What's Included in Each Plan</h2>
      </div>
      <div class="overflow-hidden rounded-2xl border border-[#E3E8F1] bg-white shadow-sm">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-[#E3E8F1] bg-[#0B2545]">
              <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-widest text-[#8EA8C3]">Feature</th>
              <th class="px-4 py-4 text-center text-xs font-bold uppercase tracking-widest text-white">Starter<br/><span class="text-[#8EA8C3] font-normal normal-case tracking-normal">$247/mo</span></th>
              <th class="px-4 py-4 text-center text-xs font-bold uppercase tracking-widest text-[#2E8BFF]">Core<br/><span class="text-[#8EA8C3] font-normal normal-case tracking-normal">$447/mo</span></th>
              <th class="px-4 py-4 text-center text-xs font-bold uppercase tracking-widest text-white">Core + SEO<br/><span class="text-[#8EA8C3] font-normal normal-case tracking-normal">$849/mo</span></th>
            </tr>
          </thead>
          <tbody>
            {compare.map((row, i) => (
              <tr class={`border-b border-[#F4F6FA] ${i % 2 === 0 ? 'bg-white' : 'bg-[#FAFBFD]'}`}>
                <td class="px-6 py-3 text-[#44506A]">{row.feature}</td>
                <td class="px-4 py-3 text-center">
                  {row.starter
                    ? <svg class="mx-auto h-5 w-5 text-[#22C55E]" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7 7a1 1 0 01-1.4 0l-3-3a1 1 0 011.4-1.4l2.3 2.3 6.3-6.3a1 1 0 011.4 0z" clip-rule="evenodd"/></svg>
                    : <span class="text-[#C5CCD6]">—</span>}
                </td>
                <td class="px-4 py-3 text-center">
                  {row.core
                    ? <svg class="mx-auto h-5 w-5 text-[#22C55E]" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7 7a1 1 0 01-1.4 0l-3-3a1 1 0 011.4-1.4l2.3 2.3 6.3-6.3a1 1 0 011.4 0z" clip-rule="evenodd"/></svg>
                    : <span class="text-[#C5CCD6]">—</span>}
                </td>
                <td class="px-4 py-3 text-center">
                  {row.seo
                    ? <svg class="mx-auto h-5 w-5 text-[#22C55E]" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7 7a1 1 0 01-1.4 0l-3-3a1 1 0 011.4-1.4l2.3 2.3 6.3-6.3a1 1 0 011.4 0z" clip-rule="evenodd"/></svg>
                    : <span class="text-[#C5CCD6]">—</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="px-4 py-20 md:py-24">
    <div class="mx-auto max-w-3xl">
      <div class="mb-12 text-center">
        <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-[#2E8BFF]">Common Questions</p>
        <h2 class="text-3xl font-bold text-[#0B2545] md:text-4xl">Pricing FAQ</h2>
      </div>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <div class="rounded-2xl border border-[#E3E8F1] bg-white p-6">
            <p class="font-bold text-[#0B2545]">{faq.q}</p>
            <p class="mt-2 text-sm leading-relaxed text-[#44506A]">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[#0B2545] px-4 py-20 md:py-24">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="text-3xl font-bold text-white md:text-4xl">Not Sure Which Plan Is Right?</h2>
      <p class="mx-auto mt-5 max-w-xl text-lg text-[#8EA8C3]">
        Call us. We'll look at your current situation and tell you honestly which plan makes sense — or if any of them do. No pressure.
      </p>
      <div class="mt-8 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        <a href={phoneHref} class="inline-flex items-center gap-2 rounded-xl bg-[#2E8BFF] px-8 py-4 text-base font-bold text-white transition hover:bg-[#1E7AEB]">
          Call Now — {phone}
        </a>
        <a href="/contact" class="inline-flex rounded-xl border-2 border-white/30 px-8 py-4 text-base font-semibold text-white transition hover:border-white hover:bg-white/10">
          Send a Message
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
