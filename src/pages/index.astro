<script>
  // ── Star field ──
  (function() {
    const canvas = document.getElementById('star-canvas') as HTMLCanvasElement;
    const grid   = document.getElementById('hero-grid-container') as HTMLElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    function resize() {
      canvas.width  = canvas.offsetWidth;
      canvas.height = canvas.offsetHeight;
    }
    resize();
    window.addEventListener('resize', resize);

    const STAR_COUNT = 190;
    const stars = Array.from({ length: STAR_COUNT }, () => ({
      x:       Math.random(),
      y:       Math.random(),
      r:       Math.random() * 1.1 + 0.35,
      alpha:   Math.random() * 0.45 + 0.45,
      speed:   Math.random() * 0.003 + 0.001,
      twinkle: Math.random() * Math.PI * 2,
      color:   Math.random() > 0.75 ? '#06D6FF' : '#ffffff',
    }));

    function drawStars() {
      if (!ctx) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      stars.forEach(s => {
        s.twinkle += s.speed * 2;
        const opacity = (Math.sin(s.twinkle) * 0.4 + 0.6) * s.alpha;
        const cx = s.x * canvas.width;
        const cy = s.y * canvas.height;
        ctx.beginPath();
        ctx.arc(cx, cy, s.r, 0, Math.PI * 2);
        ctx.fillStyle = s.color;
        ctx.globalAlpha = opacity;
        ctx.fill();
        const grd = ctx.createRadialGradient(cx, cy, 0, cx, cy, s.r * 3.5);
        grd.addColorStop(0, s.color);
        grd.addColorStop(1, 'transparent');
        ctx.beginPath();
        ctx.arc(cx, cy, s.r * 3.5, 0, Math.PI * 2);
        ctx.fillStyle = grd;
        ctx.globalAlpha = opacity * 0.25;
        ctx.fill();
        if (s.r > 1.4) {
          ctx.globalAlpha = opacity * 0.6;
          ctx.strokeStyle = s.color;
          ctx.lineWidth = 0.7;
          const len = s.r * 4;
          ctx.beginPath();
          ctx.moveTo(cx - len, cy); ctx.lineTo(cx + len, cy);
          ctx.moveTo(cx, cy - len); ctx.lineTo(cx, cy + len);
          ctx.stroke();
        }
      });
      ctx.globalAlpha = 1;
      requestAnimationFrame(drawStars);
    }
    drawStars();

    setTimeout(() => { canvas.style.opacity = '1'; }, 300);
    setTimeout(() => {
      canvas.style.transition = 'opacity 3s ease';
      canvas.style.opacity = '0';
      if (grid) {
        setTimeout(() => { grid.style.opacity = '1'; }, 1500);
      }
    }, 30000);
  })();

  // ── Scroll reveal — fixed threshold + fallback ──
  const revealEls = document.querySelectorAll('.reveal, .reveal-left');

  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        revealObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.05, rootMargin: '0px 0px -40px 0px' });

  revealEls.forEach(el => revealObserver.observe(el));

  // Safety fallback: show any in-viewport reveals after load
  window.addEventListener('load', () => {
    setTimeout(() => {
      document.querySelectorAll('.reveal, .reveal-left').forEach(el => {
        if (!el.classList.contains('visible')) {
          const rect = el.getBoundingClientRect();
          if (rect.top < window.innerHeight + 100) {
            el.classList.add('visible');
          }
        }
      });
    }, 200);
  });

  // ── Count-up — fixed threshold + fallback ──
  function countUp(el: HTMLElement) {
    const target = parseInt(el.dataset.target || '0');
    const suffix = el.dataset.suffix || '';
    const duration = 1800;
    const step = target / (duration / 16);
    let current = 0;
    const timer = setInterval(() => {
      current += step;
      if (current >= target) {
        current = target;
        clearInterval(timer);
      }
      el.textContent = Math.floor(current) + suffix;
    }, 16);
  }

  const counters = document.querySelectorAll<HTMLElement>('.counter-num[data-target]');
  const counterObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        countUp(entry.target as HTMLElement);
        counterObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });
  counters.forEach(el => counterObserver.observe(el));

  // Fallback: run counters if already in view on load
  window.addEventListener('load', () => {
    setTimeout(() => {
      counters.forEach(el => {
        const rect = el.getBoundingClientRect();
        if (rect.top < window.innerHeight) {
          countUp(el);
          counterObserver.unobserve(el);
        }
      });
    }, 300);
  });
</script>

<script>
  // ── "Up and Running in 3 Steps" section: orbiting star field ──
  // Ported 1:1 from the 21st.dev "Stars Canvas" component (React) to vanilla
  // canvas. Same orbit/twinkle math. speedMultiplier = 0.5 → stars 50% slower.
  (function () {
    const canvas = document.getElementById('process-star-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    // Tunables (mirror the StarsCanvas props)
    const MAX_STARS = 1200;
    const HUE = 217;
    const BRIGHTNESS = 10;
    const SPEED_MULTIPLIER = 0.35; // 0.35x star speed
    const TWINKLE = 20;
    const BG = '#0B2545';         // NSD dark navy (copied from this section)

    let w = 0, h = 0;
    let stars: any[] = [];
    let rafId: number | null = null;
    let running = false;

    // Cached radial-gradient star sprite (drawn once, reused per star)
    const sprite = document.createElement('canvas');
    sprite.width = sprite.height = 100;
    const sctx = sprite.getContext('2d')!;
    const half = sprite.width / 2;
    const grad = sctx.createRadialGradient(half, half, 0, half, half, half);
    grad.addColorStop(0.025, '#fff');
    grad.addColorStop(0.1, `hsl(${HUE}, 61%, 33%)`);
    grad.addColorStop(0.25, `hsl(${HUE}, 64%, 6%)`);
    grad.addColorStop(1, 'transparent');
    sctx.fillStyle = grad;
    sctx.beginPath();
    sctx.arc(half, half, half, 0, Math.PI * 2);
    sctx.fill();

    const rand = (min: number, max?: number) => {
      if (max === undefined) { max = min; min = 0; }
      if (min > max) { const t = min; min = max; max = t; }
      return Math.floor(Math.random() * (max - min + 1)) + min;
    };
    const maxOrbit = (x: number, y: number) => {
      const m = Math.max(x, y);
      return Math.round(Math.sqrt(m * m + m * m)) / 2;
    };

    function makeStar() {
      const orbitRadius = rand(maxOrbit(w, h));
      return {
        orbitRadius,
        radius: rand(60, orbitRadius) / 12,
        orbitX: w / 2,
        orbitY: h / 2,
        timePassed: rand(0, MAX_STARS),
        speed: (rand(orbitRadius) / 50000) * SPEED_MULTIPLIER,
        alpha: (rand(2, 10) / 10) * BRIGHTNESS,
      };
    }

    function build() {
      stars = [];
      for (let i = 0; i < MAX_STARS; i++) stars.push(makeStar());
    }

    function resize() {
      w = canvas!.width = canvas!.offsetWidth;
      h = canvas!.height = canvas!.offsetHeight;
      build();
    }

    function drawStar(s: any) {
      const x = Math.sin(s.timePassed) * s.orbitRadius + s.orbitX;
      const y = Math.cos(s.timePassed) * s.orbitRadius + s.orbitY;
      const tw = rand(TWINKLE);
      if (tw === 1 && s.alpha > 0) s.alpha -= 0.05;
      else if (tw === 2 && s.alpha < 1) s.alpha += 0.05;
      ctx!.globalAlpha = s.alpha;
      ctx!.drawImage(sprite, x - s.radius / 2, y - s.radius / 2, s.radius, s.radius);
      s.timePassed += s.speed;
    }

    function frame() {
      ctx!.globalCompositeOperation = 'source-over';
      ctx!.globalAlpha = 0.8;
      ctx!.fillStyle = BG;
      ctx!.fillRect(0, 0, w, h);
      ctx!.globalCompositeOperation = 'lighter';
      for (let i = 0; i < stars.length; i++) drawStar(stars[i]);
      rafId = requestAnimationFrame(frame);
    }

    function start() { if (!running) { running = true; frame(); } }
    function stop() { running = false; if (rafId) cancelAnimationFrame(rafId); rafId = null; }

    resize();
    let rt: number | undefined;
    window.addEventListener('resize', () => { clearTimeout(rt); rt = window.setTimeout(resize, 200); });

    // Respect reduced-motion: paint a single static frame, no animation.
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      ctx.globalAlpha = 1; ctx.fillStyle = BG; ctx.fillRect(0, 0, w, h);
      ctx.globalCompositeOperation = 'lighter';
      for (let i = 0; i < stars.length; i++) drawStar(stars[i]);
      return;
    }

    // Only animate while the section is on screen (saves CPU/battery).
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach(e => (e.isIntersecting ? start() : stop()));
      }, { threshold: 0.05 });
      io.observe(canvas);
    } else {
      start();
    }
  })();
</script>

<script>
  // ── AI Voice Agent — animated transcript + spoken audio demo ──
  (function () {
    const playBtn = document.getElementById('voice-demo-play');
    const transcript = document.getElementById('voice-demo-transcript');
    const statusEl = document.getElementById('voice-demo-status');
    const dotEl = document.getElementById('voice-demo-dot');
    const labelEl = document.getElementById('voice-demo-label');
    const hintEl = document.getElementById('voice-demo-hint');
    if (!playBtn || !transcript) return;

    const lines = [
      { who: 'ai',     text: 'Thanks for calling North Star Digital — this is the AI assistant. How can I help?' },
      { who: 'caller', text: "Hi, I've got a burst pipe in my basement and there's water everywhere." },
      { who: 'ai',     text: "Let's get that handled fast. I can have a licensed plumber out to you today. What's your name and address?" },
      { who: 'caller', text: 'It\'s Dave — 142 Oak Street, Pewaukee.' },
      { who: 'ai',     text: 'Thanks, Dave. I have a 2:30 or a 4:00 open this afternoon. Which works better for you?' },
      { who: 'caller', text: '2:30 is perfect.' },
      { who: 'ai',     text: "You're booked for 2:30. I've texted you a confirmation and the plumber's name. Help is on the way." },
    ];

    const synth = typeof window !== 'undefined' ? window.speechSynthesis : null;
    let playing = false;

    function pickVoice() {
      if (!synth) return null;
      const v = synth.getVoices();
      return v.find(x => /en[-_]US/i.test(x.lang) && /(female|samantha|zira|jenny|aria|google us english)/i.test(x.name))
          || v.find(x => /^en/i.test(x.lang))
          || v[0] || null;
    }
    if (synth) { try { synth.getVoices(); synth.onvoiceschanged = pickVoice; } catch (e) {} }

    const wait = (ms) => new Promise(r => setTimeout(r, ms));

    function speak(text) {
      return new Promise((resolve) => {
        if (!synth) return resolve();
        try {
          const u = new SpeechSynthesisUtterance(text);
          const voice = pickVoice();
          if (voice) u.voice = voice;
          u.rate = 1.03; u.pitch = 1.0;
          u.onend = resolve; u.onerror = resolve;
          synth.speak(u);
          // safety: never hang if onend never fires
          setTimeout(resolve, Math.min(9000, 600 + text.length * 80));
        } catch (e) { resolve(); }
      });
    }

    function addBubble(who) {
      const wrap = document.createElement('div');
      wrap.className = 'flex flex-col ' + (who === 'ai' ? 'items-start' : 'items-end');
      const label = document.createElement('span');
      label.className = 'mb-1 text-[10px] font-bold uppercase tracking-widest ' + (who === 'ai' ? 'text-[#06D6FF]' : 'text-[#8EA8C3]');
      label.textContent = who === 'ai' ? 'AI Agent' : 'Caller';
      const bubble = document.createElement('div');
      bubble.className = who === 'ai'
        ? 'max-w-[92%] rounded-2xl rounded-tl-sm border border-[#06D6FF]/30 bg-[#06D6FF]/10 px-4 py-2.5 leading-relaxed text-[#dbe9ff]'
        : 'max-w-[92%] rounded-2xl round