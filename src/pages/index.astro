---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroGrid from '../components/HeroGrid.astro';

const pageTitle = 'North Star Digital | AI-Powered Growth Systems — Wisconsin';
const description =
  'North Star Digital builds, manages, and runs complete AI-powered websites, SEO, and automated lead follow-up systems for Wisconsin contractors and service businesses — 100% done for you. Plans starting at $299/mo.';

const phone = '(262) 254-0128';
const phoneHref = 'tel:+12622540128';
---

<BaseLayout title={pageTitle} description={description} path="/">

  <!-- ═══ HERO ═══ -->
  <section class="hero-glow relative overflow-hidden px-4 py-20 md:py-32">
    <canvas id="star-canvas" class="pointer-events-none absolute inset-0 h-full w-full opacity-0" style="transition: opacity 1.2s ease;"></canvas>
    <div id="hero-grid-container" class="pointer-events-none absolute inset-0 opacity-0" style="transition: opacity 2.5s ease;">
      <HeroGrid />
    </div>
    <div class="pointer-events-none absolute left-1/4 top-1/4 h-96 w-96 rounded-full bg-[#2E8BFF] opacity-10 blur-3xl"></div>
    <div class="pointer-events-none absolute right-1/4 top-1/2 h-64 w-64 rounded-full bg-[#06D6FF] opacity-10 blur-3xl"></div>

    <div class="relative mx-auto max-w-5xl text-center">
      <p class="animate-fade-in-up badge-teal mb-6 inline-block rounded-full border px-4 py-1 text-xs font-semibold uppercase tracking-widest">
        📍 Wisconsin — AI-Powered Growth Agency
      </p>
      <h1 class="animate-fade-in-up animate-delay-100 text-4xl font-bold leading-tight text-white md:text-6xl">
        Done-For-You AI Systems<br class="hidden md:block" />
        <span class="gradient-text">That Get Your Phone Ringing.</span>
      </h1>
      <p class="animate-fade-in-up animate-delay-200 mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-[#8EA8C3]">
        We build, manage, and run complete AI-powered websites, local SEO, and automated lead follow-up systems for Wisconsin contractors and service businesses — <span class="font-semibold text-white">100% done for you, so you can focus on the work.</span>
      </p>
      <div class="animate-fade-in-up animate-delay-300 mt-8 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        <a
          href="/contact"
          class="btn-glow inline-flex items-center gap-2 rounded-xl bg-[#2E8BFF] px-8 py-4 text-base font-bold text-white shadow-lg transition-all duration-200 hover:scale-105 hover:bg-[#1E7AEB]"
        >
          Apply for a Strategy Session
        </a>
        <a
          href={phoneHref}
          class="inline-flex items-center gap-2 rounded-xl border-2 border-[#06D6FF]/40 px-8 py-4 text-base font-semibold text-white transition-all duration-200 hover:border-[#06D6FF] hover:bg-[#06D6FF]/10"
        >
          <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>
          Call Now — {phone}
        </a>
      </div>
      <p class="animate-fade-in-up animate-delay-400 mt-4 text-sm text-[#8EA8C3]">Free consultation · No contracts · Results in 30 days</p>

      <!-- Stats row -->
      <div class="animate-fade-in-up animate-delay-500 mx-auto mt-14 grid max-w-2xl grid-cols-3 gap-4 border-t border-white/10 pt-10">
        <div>
          <p class="counter-num text-2xl font-bold text-white" data-target="30" data-suffix=" days">0</p>
          <p class="mt-1 text-xs text-[#8EA8C3]">Average time to results</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-[#06D6FF]">$299<span class="text-base font-normal text-[#8EA8C3]">/mo</span></p>
          <p class="mt-1 text-xs text-[#8EA8C3]">Plans starting from</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-white">100%</p>
          <p class="mt-1 text-xs text-[#8EA8C3]">Done For You</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ SOCIAL PROOF BAR ═══ -->
  <div class="divider-glow"></div>
  <section class="border-b border-[#E3E8F1] bg-[#F0F6FF] px-4 py-5">
    <div class="mx-auto max-w-5xl">
      <div class="flex flex-wrap items-center justify-center gap-6 text-sm font-semibold text-[#44506A]">
        <span class="flex items-center gap-2"><span class="text-[#06D6FF]">✓</span> 30-Day Money-Back Guarantee</span>
        <span class="hidden text-[#DDE5F2] md:block">|</span>
        <span>✓ AI-Powered Systems</span>
        <span class="hidden text-[#DDE5F2] md:block">|</span>
        <span>✓ 100% Done For You</span>
        <span class="hidden text-[#DDE5F2] md:block">|</span>
        <span>✓ Results Within 30 Days</span>
        <span class="hidden text-[#DDE5F2] md:block">|</span>
        <span>✓ Father-Son Team — Wisconsin</span>
      </div>
    </div>
  </section>
  <div class="divider-glow"></div>

  <!-- ═══ SERVICES ═══ -->
  <section class="section-light px-4 py-20 md:py-24">
    <div class="mx-auto max-w-5xl">
      <div class="reveal mb-12 text-center">
        <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-[#06D6FF]">What We Do</p>
        <h2 class="text-3xl font-bold text-[#0B2545] md:text-4xl">AI-Powered Growth Systems,<br class="hidden md:block" /> Built and Managed For You</h2>
        <p class="mx-auto mt-4 max-w-2xl text-base text-[#44506A]">We don't just build it and leave. Every service is fully set up, managed, and optimized by our team — automatically, without you lifting a finger.</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2">
        <div class="card-hover reveal rounded-2xl border border-[#E3E8F1] bg-white p-8 shadow-sm">
          <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl icon-teal">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0H3" /></svg>
          </div>
          <h3 class="text-xl font-bold text-[#0B2545]">High-Converting Website</h3>
          <p class="mt-2 text-sm leading-relaxed text-[#44506A]">We design, build, host, and maintain your website. Fast, mobile-ready, and built around one goal: turning visitors into phone calls. No tech skills needed on your end — ever.</p>
        </div>
        <div class="card-hover reveal rounded-2xl border border-[#E3E8F1] bg-white p-8 shadow-sm" style="transition-delay:0.1s">
          <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl icon-teal">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" /></svg>
          </div>
          <h3 class="text-xl font-bold text-[#0B2545]">Local SEO</h3>
          <p class="mt-2 text-sm leading-relaxed text-[#44506A]">We handle all the ongoing SEO work — Google Business Profile, local citations, keyword rankings, and monthly reports. You show up first. We do all the work.</p>
        </div>
        <div class="card-hover reveal rounded-2xl border border-[#E3E8F1] bg-white p-8 shadow-sm" style="transition-delay:0.2s">
          <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl icon-teal">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" /></svg>
          </div>
          <h3 class="text-xl font-bold text-[#0B2545]">CRM & Lead Management</h3>
          <p class="mt-2 text-sm leading-relaxed text-[#44506A]">We set up and run a complete lead tracking system. Every inquiry is captured, followed up with automatically, and tracked until it closes. You never lose a lead again.</p>
        </div>
        <div class="card-hover reveal rounded-2xl border border-[#E3E8F1] bg-white p-8 shadow-sm" style="transition-delay:0.3s">
          <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl icon-teal">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" /></svg>
          </div>
          <h3 class="text-xl font-bold text-[#0B2545]">Marketing Automation</h3>
          <p class="mt-2 text-sm leading-relaxed text-[#44506A]">Automated follow-up sequences, review requests, appointment reminders — all built, configured, and managed by us. Your pipeline runs itself around the clock.</p>
        </div>
      </div>

      <!-- AI Voice Agent — Featured Card -->
      <div class="reveal mt-6">
        <div class="card-hover-ai ai-scan relative rounded-2xl border-2 border-[#2E8BFF]/40 bg-gradient-to-br from-[#0B2545] to-[#0d2f5e] p-8 shadow-lg overflow-hidden">
          <div class="flex flex-col gap-6 md:flex-row md:items-center">
            <div class="flex-1">
              <div class="mb-3 flex items-center gap-3">
                <div class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-[#2E8BFF]/20">
                  <svg class="h-6 w-6 text-[#06D6FF]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 01-3-3V4.5a3 3 0 116 0v8.25a3 3 0 01-3 3z" /></svg>
                </div>
                <span class="inline-flex items-center gap-1.5 rounded-full border border-[#06D6FF]/40 bg-[#06D6FF]/10 px-3 py-1 text-xs font-bold uppercase tracking-widest text-[#06D6FF]"><span class="live-dot"></span> LIVE — AI Voice Agent</span>
              </div>
              <h3 class="text-xl font-bold text-white">AI Voice Agent</h3>
              <p class="mt-2 text-sm leading-relaxed text-[#8EA8C3]">An AI that answers your phone calls 24/7, qualifies leads, and books appointments directly into your calendar — even when you're on a job. Never miss a call. Never miss a lead.</p>
            </div>
            <div class="shrink-0">
              <a href="/services" class="btn-glow-teal inline-flex items-center gap-2 rounded-xl border-2 border-[#06D6FF]/50 px-6 py-3 text-sm font-bold text-[#06D6FF] transition-all hover:border-[#06D6FF] hover:bg-[#06D6FF]/10">
                See How It Works →
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="reveal mt-10 text-center">
        <a href="/services" class="inline-flex items-center gap-2 text-sm font-semibold text-[#2E8BFF] hover:text-[#06D6FF] hover:underline">
          View All Services &amp; Pricing →
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ HOW IT WORKS ═══ -->
  <section class="hero-glow relative overflow-hidden px-4 py-20 md:py-24">
    <HeroGrid />
    <div class="relative mx-auto max-w-5xl">
      <div class="reveal mb-12 text-center">
        <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-[#06D6FF]">Simple Process</p>
        <h2 class="text-3xl font-bold text-white md:text-4xl">Up and Running in 3 Steps</h2>
        <p class="mx-auto mt-4 max-w-xl text-base text-[#8EA8C3]">No confusing onboarding. No back-and-forth for months. We handle everything and move fast.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-3">
        <div class="reveal text-center">
          <div class="btn-glow-teal mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full border border-[#06D6FF]/40 bg-[#06D6FF]/10 text-xl font-bold text-[#06D6FF]">1</div>
          <h3 class="text-lg font-bold text-white">Strategy Session</h3>
          <p class="mt-2 text-sm leading-relaxed text-[#8EA8C3]">We review your business, your goals, and exactly what's holding you back online. Honest, no-pitch conversation.</p>
        </div>
        <div class="reveal text-center" style="transition-delay:0.15s">
          <div class="btn-glow-teal mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full border border-[#06D6FF]/40 bg-[#06D6FF]/10 text-xl font-bold text-[#06D6FF]">2</div>
          <h3 class="text-lg font-bold text-white">We Build &amp; Run Everything</h3>
          <p class="mt-2 text-sm leading-relaxed text-[#8EA8C3]">Our team builds your site, configures your AI systems, sets up your CRM, and manages everything ongoing. You don't touch a thing.</p>
        </div>
        <div class="reveal text-center" style="transition-delay:0.3s">
          <div class="btn-glow-teal mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full border border-[#06D6FF]/40 bg-[#06D6FF]/10 text-xl font-bold text-[#06D6FF]">3</div>
          <h3 class="text-lg font-bold text-white">Your Phone Rings</h3>
          <p class="mt-2 text-sm leading-relaxed text-[#8EA8C3]">Leads come in, follow-ups go out automatically, and your pipeline fills up. You focus on doing the work — we handle the rest.</p>
        </div>
      </div>
      <div class="reveal mt-12 text-center">
        <a href="/contact" class="btn-glow inline-flex items-center gap-2 rounded-xl bg-[#2E8BFF] px-8 py-4 text-base font-bold text-white transition-all duration-200 hover:scale-105 hover:bg-[#1E7AEB]">
          Apply for a Strategy Session
        </a>
        <p class="mt-3 text-sm text-[#8EA8C3]">Or <a href={phoneHref} class="text-[#06D6FF] underline hover:text-white">call us at {phone}</a> — we pick up.</p>
      </div>
    </div>
  </section>

  <!-- ═══ WHO WE ARE ═══ -->
  <section class="section-light px-4 py-20 md:py-24">
    <div class="mx-auto max-w-5xl">
      <div class="grid gap-12 md:grid-cols-2 md:items-center">
        <div class="reveal-left">
          <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-[#06D6FF]">Who We Are</p>
          <h2 class="text-3xl font-bold text-[#0B2545] md:text-4xl">A Local Team That Actually Cares</h2>
          <p class="mt-4 text-base leading-relaxed text-[#44506A]">
            North Star Digital is a father-son AI agency based in Wisconsin. We're not a faceless corporation or an overseas call center — we're a dedicated local team that treats every client like a partner.
          </p>
          <p class="mt-4 text-base leading-relaxed text-[#44506A]">
            We started NSD because we saw too many great local businesses losing jobs online — not because their work was bad, but because their digital systems were. We fix that with modern AI tools, and we manage everything so you never have to think about it.
          </p>
          <p class="mt-4 text-base font-semibold text-[#0B2545]">We fix that. Fast.</p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="/contact" class="btn-glow inline-flex items-center gap-2 rounded-xl bg-[#2E8BFF] px-6 py-3 text-sm font-bold text-white transition-all duration-200 hover:scale-105 hover:bg-[#1E7AEB]">Apply for a Strategy Session</a>
            <a href="/about" class="inline-flex rounded-xl border border-[#06D6FF]/40 px-6 py-3 text-sm font-semibold text-[#2E8BFF] transition-all duration-200 hover:border-[#06D6FF] hover:bg-[#06D6FF]/5">Our Story →</a>
          </div>
        </div>
        <div class="reveal space-y-4">
          <div class="card-hover rounded-2xl border border-[#E3E8F1] bg-[#F4F6FA] p-6">
            <p class="text-sm font-bold text-[#0B2545]"><span class="text-[#06D6FF]">📍</span> Headquartered in Wisconsin</p>
            <p class="mt-1 text-sm text-[#44506A]">We're a real team with a real address. Not a call center, not an overseas agency — people you can actually meet.</p>
          </div>
          <div class="card-hover rounded-2xl border border-[#E3E8F1] bg-[#F4F6FA] p-6">
            <p class="text-sm font-bold text-[#0B2545]"><span class="text-[#06D6FF]">⚡</span> 100% Done For You</p>
            <p class="mt-1 text-sm text-[#44506A]">We build it, we run it, we manage it. You don't need any tech experience — just tell us your goals and we handle everything else.</p>
          </div>
          <div class="card-hover rounded-2xl border border-[#E3E8F1] bg-[#F4F6FA] p-6">
            <p class="text-sm font-bold text-[#0B2545]"><span class="text-[#06D6FF]">💰</span> Fair — Transparent Pricing</p>
            <p class="mt-1 text-sm text-[#44506A]">One monthly price covers everything. No surprise bills. No confusing add-ons. No contracts.</p>
          </div>
          <div class="card-hover rounded-2xl border border-[#E3E8F1] bg-[#F4F6FA] p-6">
            <p class="text-sm font-bold text-[#0B2545]"><span class="text-[#06D6FF]">🤝</span> Honest — We'll Tell You the Truth</p>
            <p class="mt-1 text-sm text-[#44506A]">If something isn't working, we'll tell you. We're here for your long-term growth, not just your first invoice.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ SOCIAL PROOF ═══ -->
  <section class="bg-[#F0F6FF] px-4 py-20 md:py-24">
    <div class="divider-glow-subtle mb-0"></div>
    <div class="mx-auto max-w-5xl">
      <div class="reveal mb-12 text-center">
        <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-[#06D6FF]">Social Proof</p>
        <h2 class="text-3xl font-bold text-[#0B2545] md:text-4xl">Be Our First Success Story</h2>
      </div>
      <div class="reveal mx-auto max-w-2xl rounded-2xl bg-white p-10 text-center shadow-sm">
        <p class="text-4xl leading-none">⭐</p>
        <p class="mt-4 text-base font-semibold text-[#0B2545]">We're just getting started — and reviews are coming.</p>
        <p class="mt-2 text-sm leading-relaxed text-[#44506A]">We back every project with a 30-day money-back guarantee. If we don't deliver, you pay nothing — no contract, no lock-in. We'd rather earn your trust than fake it.</p>
        <a
          href="https://maps.google.com/?q=North+Star+Digital+Waukesha+WI"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex items-center gap-2 rounded-xl bg-[#2E8BFF] px-6 py-3 text-sm font-bold text-white transition hover:bg-[#1a6fcc]"
        >Leave Us a Google Review →</a>
      </div>
    </div>
  </section>

  <!-- ═══ PRICING TEASER ═══ -->
  <section class="section-light px-4 py-20 md:py-24">
    <div class="mx-auto max-w-5xl">
      <div class="reveal mb-12 text-center">
        <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-[#06D6FF]">Simple Pricing</p>
        <h2 class="text-3xl font-bold text-[#0B2545] md:text-4xl">One Plan. Everything Included.</h2>
        <p class="mx-auto mt-4 max-w-xl text-base text-[#44506A]">Pick a plan and get a complete, fully-managed AI growth system — website, SEO, CRM, automation, and ongoing support. No hidden fees, no contracts.</p>
      </div>
      <div class="reveal grid gap-6 md:grid-cols-3">
        <div class="card-hover rounded-2xl border border-[#E3E8F1] bg-white p-8 shadow-sm text-center">
          <p class="text-xs font-semibold uppercase tracking-widest text-[#2E8BFF]">Starter</p>
          <p class="mt-3 text-4xl font-bold text-[#0B2545]">$299<span class="text-lg font-normal text-[#44506A]">/mo</span></p>
          <p class="mt-3 text-sm text-[#44506A]">Website + hosting, mobile-ready, basic SEO, Google Business Profile, monthly report.</p>
          <a href="/services" class="mt-6 block rounded-xl border border-[#2E8BFF] py-3 text-sm font-bold text-[#2E8BFF] transition hover:bg-[#F0F6FF]">See What's Included</a>
        </div>
        <div class="card-hover relative rounded-2xl border-2 border-[#2E8BFF] bg-white p-8 shadow-lg text-center">
          <p class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-[#2E8BFF] px-4 py-1 text-xs font-bold text-white">Most Popular</p>
          <p class="text-xs font-semibold uppercase tracking-widest text-[#2E8BFF]">Growth</p>
          <p class="mt-3 text-4xl font-bold text-[#0B2545]">$499<span class="text-lg font-normal text-[#44506A]">/mo</span></p>
          <p class="mt-3 text-sm text-[#44506A]">Everything in Starter + local SEO, CRM, automated follow-up, monthly strategy call.</p>
          <a href="/services" class="mt-6 block rounded-xl bg-[#2E8BFF] py-3 text-sm font-bold text-white transition hover:bg-[#1E7AEB]">See What's Included</a>
        </div>
        <div class="card-hover rounded-2xl border border-[#E3E8F1] bg-white p-8 shadow-sm text-center">
          <p class="text-xs font-semibold uppercase tracking-widest text-[#2E8BFF]">Pro</p>
          <p class="mt-3 text-4xl font-bold text-[#0B2545]">$999<span class="text-lg font-normal text-[#44506A]">/mo</span></p>
          <p class="mt-3 text-sm text-[#44506A]">Everything in Growth + full AI automation, AI Voice Agent, custom integrations, dedicated manager.</p>
          <a href="/services" class="mt-6 block rounded-xl border border-[#2E8BFF] py-3 text-sm font-bold text-[#2E8BFF] transition hover:bg-[#F0F6FF]">See What's Included</a>
        </div>
      </div>
      <div class="reveal mt-8 text-center">
