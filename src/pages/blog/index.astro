---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const pageTitle = 'Blog | North Star Digital — Pewaukee, WI';
const description = 'Tips, guides, and insights for Wisconsin small businesses on web design, local SEO, and getting more customers online.';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<BaseLayout title={pageTitle} description={description} path="/blog">

  <!-- HERO -->
  <section class="bg-[#0B2545] px-4 py-16 md:py-20">
    <div class="mx-auto max-w-4xl text-center">
      <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-[#2E8BFF]">From the Team</p>
      <h1 class="text-4xl font-bold text-white md:text-5xl">The NSD Blog</h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-[#8EA8C3]">
        Practical advice for Wisconsin small businesses on websites, local SEO, and getting more customers online — no fluff.
      </p>
    </div>
  </section>

  <!-- POSTS -->
  <section class="px-4 py-20 md:py-24">
    <div class="mx-auto max-w-4xl">
      {posts.length === 0 ? (
        <p class="text-center text-[#44506A]">No posts yet — check back soon.</p>
      ) : (
        <div class="space-y-10">
          {posts.map((post) => (
            <div class="nsd-reveal">
            <article class="card-hover rounded-2xl border border-[#E3E8F1] bg-white p-8 shadow-sm">
              <div class="mb-2 flex flex-wrap items-center gap-3">
                <time class="text-xs text-[#8EA8C3]">{formatDate(post.data.pubDate)}</time>
                {post.data.tags.slice(0, 3).map((tag) => (
                  <span class="rounded-full bg-[#F0F6FF] px-2.5 py-0.5 text-xs font-medium text-[#2E8BFF]">{tag}</span>
                ))}
              </div>
              <h2 class="text-xl font-bold text-[#0B2545] md:text-2xl">
                <a href={`/blog/${post.id}`} class="hover:text-[#2E8BFF] transition-colors">
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-3 text-base leading-relaxed text-[#44506A]">{post.data.description}</p>
              <a
                href={`/blog/${post.id}`}
                class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-[#2E8BFF] hover:underline"
              >
                Read more →
              </a>

            </article>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[#F4F6FA] px-4 py-16">
    <div class="nsd-reveal mx-auto max-w-2xl text-center">
      <h2 class="text-2xl font-bold text-[#0B2545]">Ready to Get More Calls?</h2>
      <p class="mt-3 text-base text-[#44506A]">We help Wisconsin service businesses grow online. Free consultation — no pressure.</p>
      <a href="tel:+12622540128" class="mt-6 inline-flex items-center gap-2 rounded-xl bg-[#2E8BFF] px-8 py-4 text-base font-bold text-white transition hover:bg-[#1E7AEB]">
        Call (262) 254-0128
      </a>
    </div>
  </section>

</BaseLayout>
