---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<BaseLayout title={`${post.data.title} | North Star Digital`} description={post.data.description} path={`/blog/${post.id}`}>

  <!-- HERO -->
  <section class="bg-[#0B2545] px-4 py-14 md:py-20">
    <div class="mx-auto max-w-3xl">
      <a href="/blog" class="mb-6 inline-flex items-center gap-1 text-sm text-[#8EA8C3] hover:text-white transition-colors">← Back to Blog</a>
      <div class="mb-3 flex flex-wrap items-center gap-3">
        <time class="text-xs text-[#8EA8C3]">{formatDate(post.data.pubDate)}</time>
        {post.data.tags.slice(0, 3).map((tag: string) => (
          <span class="rounded-full bg-white/10 px-2.5 py-0.5 text-xs font-medium text-[#8EA8C3]">{tag}</span>
        ))}
      </div>
      <h1 class="text-3xl font-bold text-white md:text-4xl leading-tight">{post.data.title}</h1>
      <p class="mt-2 text-sm text-[#8EA8C3]">By {post.data.author}</p>
    </div>
  </section>

  <!-- CONTENT -->
  <section class="px-4 py-16 md:py-20">
    <div class="mx-auto max-w-3xl">
      <article class="prose prose-lg max-w-none text-[#304059]
        prose-headings:text-[#0B2545] prose-headings:font-bold
        prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4
        prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
        prose-p:leading-relaxed prose-p:mb-5
        prose-a:text-[#2E8BFF] prose-a:no-underline hover:prose-a:underline
        prose-strong:text-[#0B2545]
        prose-ul:my-4 prose-li:my-1
        prose-li:text-[#44506A]">
        <Content />
      </article>

      <!-- Author box -->
      <div class="mt-14 rounded-2xl border border-[#E3E8F1] bg-[#F4F6FA] p-6">
        <p class="text-sm font-bold text-[#0B2545]">About North Star Digital</p>
        <p class="mt-2 text-sm leading-relaxed text-[#44506A]">
          We're a father-son digital agency based in Pewaukee, Wisconsin, serving the Waukesha and Milwaukee area. We help local service businesses get more calls, more customers, and more revenue through websites, local SEO, and automated follow-up systems.
        </p>
        <a href="tel:+12622540128" class="mt-4 inline-flex items-center gap-2 rounded-xl bg-[#2E8BFF] px-5 py-2.5 text-sm font-bold text-white transition hover:bg-[#1E7AEB]">
          Call (262) 254-0128 — Free Consultation
        </a>
      </div>

      <div class="mt-10 text-center">
        <a href="/blog" class="text-sm font-semibold text-[#2E8BFF] hover:underline">← See all posts</a>
      </div>
    </div>
  </section>

</BaseLayout>
